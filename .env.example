# PostgreSQL connection (Neon: use the pooled URL here)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"
# Neon: direct (non-pooled) URL, used by Prisma migrations. Locally, same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/oneatlas?schema=public"
# Bearer token required by POST /api/ingest
INGEST_TOKEN="change-me"
